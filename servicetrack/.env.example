PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/servicetrack?replicaSet=rs0
JWT_SECRET=replace-with-at-least-32-random-characters
CLIENT_ORIGIN=http://127.0.0.1:5173
SLOT_CAPACITY=3
# Optional local AI. The main application works without it.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# Workshop details on downloadable PDFs and message drafts.
WORKSHOP_NAME=ServiceTrack Workshop
WORKSHOP_ADDRESS=
# Optional real email. Leave blank to use copy/email/WhatsApp drafts instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Official Razorpay TEST checkout only. Never put secrets in client code.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
